{"id":"sh/b6d4f2lc","kind":"textbox","position":{"left":64,"top":49,"width":1140,"height":65},"text":"Future work and publication possibilities","style":{"fontSize":40,"typeface":"Arial","color":"#223E34","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/1gbm9s3a","kind":"textbox","position":{"left":64,"top":120,"width":1150,"height":48},"text":"Publication depends on sound data, rights and evaluation.","style":{"fontSize":21,"typeface":"Arial","color":"#67786B","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/0f2lgnmp","kind":"textbox","position":{"left":1140,"top":675,"width":80,"height":20},"text":"12 / 13","style":{"fontSize":13,"typeface":"Arial","color":"#67786B","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/ra943il8","kind":"textbox","position":{"left":64,"top":185,"width":1110,"height":89},"text":"Collect diverse, consented disgust expressions and review labels. Confirm gains on a fresh identity-disjoint cohort with equal training budgets.","style":{"fontSize":27,"typeface":"Arial","color":"#223E34","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/q903ad4n","kind":"textbox","position":{"left":64,"top":292,"width":1110,"height":89},"text":"Current test accuracy 58.34% and disgust recall 46.84% remain modest. Improve native feature learning and validate pose, lighting and webcam robustness.","style":{"fontSize":27,"typeface":"Arial","color":"#223E34","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/dcbm583y","kind":"textbox","position":{"left":64,"top":399,"width":1110,"height":89},"text":"Resolve physiological source-dimension and timing issues, obtain adequate windows and validate on held-out people and stimulus identities.","style":{"fontSize":27,"typeface":"Arial","color":"#223E34","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/sb2lcnmd","kind":"textbox","position":{"left":64,"top":506,"width":1110,"height":89},"text":"A reproducibility or systems paper is plausible after these experiments. Clinical and patent claims require separate substantiation.","style":{"fontSize":27,"typeface":"Arial","color":"#223E34","alignment":"left"},"geometry":"rect","lineWidth":0}
]}
